---
import '../styles/global.css';
import AgeGate from '../components/AgeGate.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-rule bg-sheet">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="text-xl font-extrabold">{SITE.name}</a>
      </div>
    </header>
    <main id="main" class="flex-1"><slot /></main>
    <footer class="mt-16 border-t border-rule bg-sheet">
      <p class="mx-auto max-w-6xl px-4 py-8 text-sm text-muted">{SITE.disclaimer}</p>
    </footer>
    <AgeGate />
  </body>
</html>
