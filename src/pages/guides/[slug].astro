---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const date = guide.data.updated ?? guide.data.published;
---

<Base title={`${guide.data.title} - Daily Green Deals`} description={guide.data.description} noindex={!guide.data.reviewed}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <p class="text-sm"><a href="/guides/" class="text-muted hover:underline">Guides</a></p>
    <h1 class="mt-2 text-3xl font-extrabold">{guide.data.title}</h1>
    <p class="mt-2 text-sm text-muted">Updated <time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time></p>
    <div class="prose mt-8 max-w-none"><Content /></div>
  </article>
</Base>
