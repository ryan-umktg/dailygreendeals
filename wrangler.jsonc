{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dailygreendeals",
  // Our own entry: Astro handles fetch, plus the extraction queue consumer and the nightly cron.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Runs on new.dailygreendeals.com while WordPress keeps the main domain. Add dailygreendeals.com
  // and www here at cutover. A custom domain (not workers.dev) is what lets Cloudflare Access protect /admin/.
  "routes": [{ "pattern": "new.dailygreendeals.com", "custom_domain": true }],
  "vars": {
    // Only this address may use /admin/ (checked against the Cloudflare Access login).
    "ADMIN_EMAIL": "ryan@untouchablemarketing.com",
    // Cloudflare Access team domain and the Access application's AUD tag (Zero Trust dashboard).
    // Fill these in after creating the Access application for dailygreendeals.com/admin*.
    "ACCESS_TEAM_DOMAIN": "icy-darkness-e794.cloudflareaccess.com",
    "ACCESS_AUD": "b7ba385ac5da62827df47f8b09b24a3224c3d62988cab1d6b9ba0f391c1a7648",
    // Model used to pull deals out of newsletters.
    "EXTRACT_MODEL": "claude-sonnet-5-5",
    // Optional: route extraction through Cloudflare AI Gateway, e.g.
    // https://gateway.ai.cloudflare.com/v1/<account_id>/dgd/anthropic
    "ANTHROPIC_BASE_URL": "",
    // Shared signup addresses used for many stores. Mail to these is matched by sender domain
    // (@store.com), never by address. Keep in sync with NON_STORE_ADDRESSES in the poll-inbox workflow.
    "NON_STORE_ADDRESSES": "info@dailygreendeals.com,kimberly@dailygreendeals.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dgd",
      "database_id": "b3235f10-f60d-4660-a056-3a996cfa6fdb",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    // Every newsletter exactly as received, so extraction can be re-run any time.
    { "binding": "RAW_EMAILS", "bucket_name": "dgd-raw-emails" }
  ],
  "queues": {
    "producers": [{ "binding": "EXTRACT_QUEUE", "queue": "dgd-extract" }],
    "consumers": [
      { "queue": "dgd-extract", "max_batch_size": 1, "max_retries": 3 }
    ]
  },
  "triggers": {
    // 09:07 UTC = 2:07am Denver (MST). Expires ended deals and flags stale ones.
    "crons": ["7 9 * * *"]
  }
  // Secrets (npx wrangler secret put NAME; locally in .dev.vars):
  //   ANTHROPIC_API_KEY  - deal extraction
  //   INGEST_TOKEN       - shared with the inbox poller (GitHub Actions secret of the same name)
}
